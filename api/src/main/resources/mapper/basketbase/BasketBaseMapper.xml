<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.api.app.mapper.basketbase.BasketBaseMapper">

    <resultMap id="basketBaseMap" type="com.api.app.entity.basketbase.BasketBaseDto">
        <id property="basketNo" column="basket_no"/>
        <result property="memberNo" column="member_no"/>
        <result property="goodsNo" column="goods_no"/>
        <result property="itemNo" column="item_no"/>
        <result property="quantity" column="quantity"/>
        <result property="isOrder" column="is_order"/>
        <result property="registId" column="regist_id"/>
        <result property="registDateTime" column="regist_date_time"/>
        <result property="modifyId" column="modify_id"/>
        <result property="modifyDateTime" column="modify_date_time"/>
    </resultMap>

    <insert id="insertBasketBase" parameterType="com.api.app.entity.basketbase.BasketBaseDto">
        INSERT INTO basket_base (
            basket_no,
            member_no,
            goods_no,
            item_no,
            quantity,
            is_order,
            regist_id,
            regist_date_time,
            modify_id,
            modify_date_time
        ) VALUES (
            #{basketNo},
            #{memberNo},
            #{goodsNo},
            #{itemNo},
            #{quantity},
            #{isOrder},
            #{registId},
            #{registDateTime},
            #{modifyId},
            #{modifyDateTime}
        )
    </insert>

    <select id="selectBasketBaseList" resultMap="basketBaseMap">
        SELECT
            basket_no,
            member_no,
            goods_no,
            item_no,
            quantity,
            is_order,
            regist_id,
            regist_date_time,
            modify_id,
            modify_date_time
        FROM
            basket_base
    </select>

    <select id="selectBasketBase" resultMap="basketBaseMap" parameterType="String">
        SELECT
            basket_no,
            member_no,
            goods_no,
            item_no,
            quantity,
            is_order,
            regist_id,
            regist_date_time,
            modify_id,
            modify_date_time
        FROM
            basket_base
        WHERE
            basket_no = #{basketNo}
    </select>

    <update id="updateBasketBase" parameterType="com.api.app.entity.basketbase.BasketBaseDto">
        UPDATE basket_base
        SET
            member_no = #{memberNo},
            goods_no = #{goodsNo},
            item_no = #{itemNo},
            quantity = #{quantity},
            is_order = #{isOrder},
            modify_id = #{modifyId},
            modify_date_time = #{modifyDateTime}
        WHERE
            basket_no = #{basketNo}
    </update>

    <delete id="deleteBasketBase" parameterType="String">
        DELETE FROM basket_base
        WHERE
            basket_no = #{basketNo}
    </delete>

</mapper>
